# ==========================================================================
# Godot 4
# ==========================================================================
# Import cache, editor state, generated uid/type caches. Fully regenerated on
# first open, and huge. Never commit.
.godot/

# Godot 3 leftovers, harmless to keep listed
.import/
export.cfg

# Android/iOS build templates installed into the project by the export dialog
/android/
/ios/

# Where our export presets write builds (see README)
/build/
/exports/

# export_presets.cfg is NOT ignored on purpose: it is the definition of how the
# game gets built, and you want it in the repo. It CAN hold signing/keystore
# passwords though. Before you first export, check it, and if it grows secrets,
# either move them to environment variables or uncomment the next line.
# export_presets.cfg

# .uid files (Godot 4.4+) are the stable identity of every script and resource.
# They MUST be committed -- deleting them breaks every reference in every scene.
# Listed here only so nobody "cleans them up".
!*.uid

# Godot crash dumps
logs/
mono_crash.*.json
*.log

# ==========================================================================
# .NET / C#
# ==========================================================================
bin/
obj/
.mono/
*.user
*.userprefs
*.suo
*.cache
*.nupkg
*.snupkg
project.lock.json
msbuild.binlog

# Generated by Godot on first build -- but Wipebound.csproj and Wipebound.sln
# ARE committed. Only per-user overrides are ignored.
*.csproj.user
*.sln.docstates

# ==========================================================================
# Rust backend
# ==========================================================================
backend/target/
.env

# ==========================================================================
# Editors / IDEs
# ==========================================================================
# JetBrains Rider
.idea/
*.iml
_ReSharper*/
*.DotSettings.user

# Visual Studio
.vs/
*.vsp
*.psess

# VS Code -- ignore per-user state, keep shared launch/task configs if you add them
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json

# ==========================================================================
# OS noise
# ==========================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.fuse_hidden*

# ==========================================================================
# Art source files
# ==========================================================================
# Godot imports .blend directly but leaves these behind
*.blend1
*.blend2
# Substance/Photoshop/Aseprite working files are usually kept OUT of the game
# repo (they are huge and only the export matters). Delete these lines if you
# decide to keep sources alongside, and set up Git LFS first.
*.psd
*.psb
*.aseprite
