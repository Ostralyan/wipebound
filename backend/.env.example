# The ladder's database. Migrations live in ./migrations and are applied with
# `diesel migration run` (cargo install diesel_cli --no-default-features --features postgres).
# Port matches docker-compose.yml; override both with WIPEBOUND_DB_PORT.
DATABASE_URL=postgres://wipebound:wipebound@localhost:55432/wipebound

BIND_ADDR=0.0.0.0:8080

# Shared secret the GAME SERVERS present on /v1/internal/*. This must never be
# built into a client export: the whole point of dedicated servers is that a
# player's machine cannot submit a score.
GAME_SERVER_TOKEN=change-me

# Content hashes accepted for ranking, comma separated. A run played against
# balance numbers not on this list is stored but never ranked, so a mid-season
# rebalance cannot silently pollute a ladder.
RANKED_CONTENT_HASHES=4092205ad47e21be

# The single fingerprint the default ladder is FOR. Separate from the set above,
# which exists so a deploy can overlap. Defaulting a ladder to every accepted hash
# produced one sorted list across incompatible balance numbers.
CURRENT_CONTENT_HASH=4092205ad47e21be

# Whether a run needs identities the server actually VERIFIED. Off, and it has
# to be for now: nothing produces a verified provenance yet, so switching it on
# empties the ladder. Runs already carry how much was checked -- "anonymous"
# means the id was accepted without checking, and identifies an install rather
# than a person -- so the day a platform ticket can be validated, this flag is
# the whole migration.
RANKED_REQUIRE_VERIFIED_IDENTITY=false

# How long a replay stays available, in days. Zero keeps them for ever.
# ONLY the log expires -- the numbers derived from it are permanent, so a run
# three months old keeps its meters and its ladder position and loses only the
# ability to be watched.
LOG_RETENTION_DAYS=90

# How much position overreach a run may carry and still rank. Not zero: honest
# play produces a little, because a status change takes an interval to replicate
# and for that window a client is legitimately faster than the server believes.
RANKED_MAX_OVERREACH_CM=200

# Integration tests drive the real router against a real database:
#   docker compose up -d
#   DATABASE_URL=postgres://wipebound:wipebound@localhost:55432/wipebound cargo test
#
# Without DATABASE_URL they FAIL. A suite that silently passes with no database
# reports green and proves nothing. To skip on purpose, and visibly:
#   WIPEBOUND_SKIP_DB_TESTS=1 cargo test
