# The ladder's database. Migrations live in ./migrations and are applied with
# `diesel migration run` (cargo install diesel_cli --no-default-features --features postgres).
# Port matches docker-compose.yml; override both with WIPEBOUND_DB_PORT.
DATABASE_URL=postgres://wipebound:wipebound@localhost:55432/wipebound

BIND_ADDR=0.0.0.0:8080

# Shared secret the GAME SERVERS present on /v1/internal/*. This must never be
# built into a client export: the whole point of dedicated servers is that a
# player's machine cannot submit a score.
GAME_SERVER_TOKEN=change-me

# Content hashes accepted for ranking, comma separated. A run played against
# balance numbers not on this list is stored but never ranked, so a mid-season
# rebalance cannot silently pollute a ladder.
RANKED_CONTENT_HASHES=9cf1e05383cda8ec
